# Anthropic API
ANTHROPIC_API_KEY=your-api-key-here

# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Data Directory (where CSV and markdown files are stored)
# This should be the Neo4j import directory or a local data folder
NEO4J_IMPORT_DIR=./data

# Debug mode (set to 1 to see tool calls)
DEBUG=0

# LangSmith Observability (optional, set to enable tracing)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key-here
# LANGSMITH_PROJECT=kg-factory
